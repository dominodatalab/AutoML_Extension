{
  "manifestSchemaVersion": 1,
  "project": {                                                                                                                               
    "name": "Domino_Official_AutoML_Extension",
    "description": "Contains the app for the AutoML Extension",                                                                        
    "visibility": "Private",
    "isRestricted": false
  },
  "app": {
    "computeEnvironment": {
      "type": "custom",
      "customEnvironment": {
        "name": "AutoML Extension Compute Environment",
        "dockerfilePath": "Dockerfile",
        "baseImage": "python:3.10-slim-bullseye",
        "autoCompatibleWithDomino": false,
        "visibility": "global",
        "buildArgs": {
          "EXTENSION_VERSION": "v0.0.2"
        }
      }
    },
    "appName": "Domino AutoML App",
    "appDescription": "AutoGluon-powered AutoML for tabular, time series, and multimodal data.",
    "appVersionDescription": "Domino AutoML 0.0.1",
    "vanityUrl": "automl-extension",
    "entryScript": "app_prod.sh",
    "visibility": "authenticated",
    "enableDeepLinking": true,
    "discoverable": true,
    "mountDatasets": false,
    "mountNetAppVolumes": false,
    "externalVolumeMounts": [],
    "hardwareTierIdSuggestion": "small-k8s",
    "autoscalingSpec": {
      "enabled": false
    }
  },
  "extension": {
    "name": "AutoML",
    "description": "AutoGluon-powered AutoML for tabular, time series, and multimodal data.",
    "enabled": true,
    "uiMountPointTypeConfigs": {
      "projectSidebar": {
        "enabled": true,
        "allProjects": true,
        "urlConfig": {
          "route": null,
          "contextualQueryParams": ["projectId"]
        }
      }
    }
  }
}
